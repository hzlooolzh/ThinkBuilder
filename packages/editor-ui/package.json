{
  "name": "thinkbuilder-editor",
  "version": "0.1.3",
  "description": "ThinkBuilder：把流程图变成 AI 能直接照着干活的工程骨架。DSH 侧栏里画逻辑块，机械导出一个极省 token 的文件夹树，模型用 tb_boot/tb_block 顺着读、按块实现、逐块打勾。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "flowchart",
    "ai-agent",
    "project-planning"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hzlooolzh/ThinkBuilder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzlooolzh/ThinkBuilder.git",
    "directory": "packages/editor-ui"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "core.mjs",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
